<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
    prefWidth="1000.0"
    prefHeight="700.0"
    minWidth="700.0"
    minHeight="550.0"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controllers.CarupdateController">

    <!-- ========================================================= -->
    <!-- TOP NAVIGATION -->
    <!-- ========================================================= -->

    <top>

        <HBox
            alignment="CENTER_LEFT"
            minHeight="70.0"
            prefHeight="70.0"
            spacing="15.0"
            style="-fx-background-color: #2F3438;
                   -fx-padding: 0 25 0 25;">

            <children>

                <!-- BRAND -->

                <VBox
                    alignment="CENTER_LEFT"
                    spacing="2.0">

                    <children>

                        <Label
                            text="PDR CAR RENTAL"
                            textFill="WHITE">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="20.0" />
                            </font>

                        </Label>

                        <Label
                            text="CAR MANAGEMENT"
                            textFill="#BFC3C7">

                            <font>
                                <Font size="10.0" />
                            </font>

                        </Label>

                    </children>

                </VBox>


                <!-- FLEXIBLE SPACE -->

                <Region HBox.hgrow="ALWAYS" />


                <!-- DASHBOARD -->

                <MenuButton
                    fx:id="btnDashboard"
                    mnemonicParsing="false"
                    text="Dashboard"
                    prefHeight="42.0"
                    style="-fx-background-color: #555B60;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;
                           -fx-padding: 0 18 0 18;">

                    <font>
                        <Font
                            name="System Bold"
                            size="14.0" />
                    </font>

                    <items>

                        <MenuItem
                            text="Customers"
                            onAction="#openCustomers" />

                        <MenuItem
                            text="Payments"
                            onAction="#openPayments" />

                        <MenuItem
                            text="Cars"
                            onAction="#openCars" />

                        <MenuItem
                            text="Employees"
                            onAction="#openEmployees" />

                        <MenuItem
                            text="Rentals"
                            onAction="#openRentals" />

                    </items>

                </MenuButton>


                <!-- LOGOUT -->

                <Button
                    fx:id="btnLogout"
                    mnemonicParsing="false"
                    onAction="#handleLogout"
                    text="Logout"
                    prefHeight="42.0"
                    style="-fx-background-color: #B94A48;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;
                           -fx-padding: 0 18 0 18;">

                    <font>
                        <Font
                            name="System Bold"
                            size="13.0" />
                    </font>

                </Button>

            </children>

        </HBox>

    </top>


    <!-- ========================================================= -->
    <!-- CENTER -->
    <!-- ========================================================= -->

    <center>

        <VBox
            spacing="22.0"
            fillWidth="true"
            alignment="TOP_CENTER"
            style="-fx-background-color: linear-gradient(to bottom right, #F5F5F5, #D9DDE1);
                   -fx-padding: 30 40 40 40;">

            <children>


                <!-- ================================================= -->
                <!-- PAGE TITLE -->
                <!-- ================================================= -->

                <VBox
                    alignment="CENTER_LEFT"
                    spacing="5.0"
                    maxWidth="750.0">

                    <children>

                        <Label
                            text="Update Car"
                            textFill="#303438">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="30.0" />
                            </font>

                        </Label>

                        <Label
                            text="Modify vehicle information and availability"
                            textFill="#777D83">

                            <font>
                                <Font size="14.0" />
                            </font>

                        </Label>

                    </children>

                </VBox>


                <!-- ================================================= -->
                <!-- FORM CARD -->
                <!-- ================================================= -->

                <VBox
                    spacing="20.0"
                    maxWidth="750.0"
                    fillWidth="true"
                    style="-fx-background-color: rgba(255,255,255,0.95);
                           -fx-background-radius: 16;
                           -fx-border-color: #C6C9CC;
                           -fx-border-width: 1;
                           -fx-border-radius: 16;
                           -fx-padding: 28;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0.15, 0, 5);">

                    <children>


                        <!-- FORM HEADER -->

                        <HBox
                            alignment="CENTER_LEFT"
                            spacing="10.0">

                            <children>

                                <Label
                                    text="Car Information"
                                    textFill="#444A4F">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="18.0" />
                                    </font>

                                </Label>

                                <Region
                                    HBox.hgrow="ALWAYS" />

                                <Label
                                    text="EDIT MODE"
                                    textFill="#777D83">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="11.0" />
                                    </font>

                                </Label>

                            </children>

                        </HBox>


                        <!-- ================================================= -->
                        <!-- FORM GRID -->
                        <!-- ================================================= -->

                        <GridPane
                            hgap="18.0"
                            vgap="15.0"
                            maxWidth="Infinity">

                            <columnConstraints>

                                <ColumnConstraints
                                    minWidth="110.0"
                                    prefWidth="130.0"
                                    hgrow="NEVER" />

                                <ColumnConstraints
                                    minWidth="200.0"
                                    hgrow="ALWAYS" />

                            </columnConstraints>


                            <children>


                                <!-- BRAND -->

                                <Label
                                    text="Brand"
                                    textFill="#555B60"
                                    GridPane.rowIndex="0">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Label>

                                <ComboBox
                                    fx:id="cmbBrand"
                                    editable="true"
                                    promptText="Select brand..."
                                    maxWidth="Infinity"
                                    prefHeight="45.0"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"
                                    style="-fx-background-color: #F7F7F7;
                                           -fx-border-color: #C8CCD0;
                                           -fx-border-radius: 8;
                                           -fx-background-radius: 8;" />


                                <!-- YEAR -->

                                <Label
                                    text="Year"
                                    textFill="#555B60"
                                    GridPane.rowIndex="1">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Label>


                                <HBox
                                    alignment="CENTER_LEFT"
                                    spacing="8.0"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1">

                                    <children>

                                        <ComboBox
                                            fx:id="cmbYear"
                                            promptText="Select year..."
                                            prefHeight="45.0"
                                            HBox.hgrow="ALWAYS"
                                            style="-fx-background-color: #F7F7F7;
                                                   -fx-border-color: #C8CCD0;
                                                   -fx-border-radius: 8;
                                                   -fx-background-radius: 8;" />

                                        <Label
                                            text="OR"
                                            textFill="#858A8F">

                                            <font>
                                                <Font
                                                    name="System Bold"
                                                    size="11.0" />
                                            </font>

                                        </Label>

                                        <TextField
                                            fx:id="txtNewYear"
                                            promptText="New year"
                                            prefHeight="45.0"
                                            prefWidth="100.0"
                                            style="-fx-background-color: #F7F7F7;
                                                   -fx-border-color: #C8CCD0;
                                                   -fx-border-radius: 8;
                                                   -fx-background-radius: 8;
                                                   -fx-padding: 0 10 0 10;" />

                                        <Button
                                            fx:id="btnAddYear"
                                            mnemonicParsing="false"
                                            onAction="#handleAddYear"
                                            text="Add"
                                            prefHeight="45.0"
                                            style="-fx-background-color: #555B60;
                                                   -fx-text-fill: white;
                                                   -fx-font-weight: bold;
                                                   -fx-background-radius: 8;
                                                   -fx-cursor: hand;" />

                                    </children>

                                </HBox>


                                <!-- MODEL -->

                                <Label
                                    text="Model"
                                    textFill="#555B60"
                                    GridPane.rowIndex="2">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Label>

                                <TextField
                                    fx:id="txtModel"
                                    promptText="Enter car model"
                                    prefHeight="45.0"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"
                                    style="-fx-background-color: #F7F7F7;
                                           -fx-border-color: #C8CCD0;
                                           -fx-border-radius: 8;
                                           -fx-background-radius: 8;
                                           -fx-padding: 0 12 0 12;
                                           -fx-font-size: 13px;" />


                                <!-- CAR NUMBER -->

                                <Label
                                    text="Car Number"
                                    textFill="#555B60"
                                    GridPane.rowIndex="3">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Label>

                                <TextField
                                    fx:id="txtCarNumber"
                                    promptText="Enter car number"
                                    prefHeight="45.0"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3"
                                    style="-fx-background-color: #F7F7F7;
                                           -fx-border-color: #C8CCD0;
                                           -fx-border-radius: 8;
                                           -fx-background-radius: 8;
                                           -fx-padding: 0 12 0 12;
                                           -fx-font-size: 13px;" />


                            </children>

                        </GridPane>


                        <!-- ================================================= -->
                        <!-- SECOND ROW -->
                        <!-- ================================================= -->

                        <HBox
                            spacing="18.0"
                            alignment="CENTER_LEFT">

                            <children>


                                <!-- COLOR -->

                                <VBox
                                    spacing="6.0"
                                    HBox.hgrow="ALWAYS">

                                    <children>

                                        <Label
                                            text="Color"
                                            textFill="#555B60">

                                            <font>
                                                <Font
                                                    name="System Bold"
                                                    size="13.0" />
                                            </font>

                                        </Label>

                                        <ColorPicker
                                            fx:id="colorPicker"
                                            prefHeight="45.0"
                                            maxWidth="Infinity" />

                                    </children>

                                </VBox>


                                <!-- PRICE -->

                                <VBox
                                    spacing="6.0"
                                    HBox.hgrow="ALWAYS">

                                    <children>

                                        <Label
                                            text="Price Per Day"
                                            textFill="#555B60">

                                            <font>
                                                <Font
                                                    name="System Bold"
                                                    size="13.0" />
                                            </font>

                                        </Label>

                                        <Spinner
                                            fx:id="spnPrice"
                                            editable="true"
                                            prefHeight="45.0"
                                            maxWidth="Infinity" />

                                    </children>

                                </VBox>


                                <!-- STATUS -->

                                <VBox
                                    spacing="6.0"
                                    HBox.hgrow="ALWAYS">

                                    <children>

                                        <Label
                                            text="Status"
                                            textFill="#555B60">

                                            <font>
                                                <Font
                                                    name="System Bold"
                                                    size="13.0" />
                                            </font>

                                        </Label>

                                        <ComboBox
                                            fx:id="cmbStatus"
                                            promptText="Select status..."
                                            prefHeight="45.0"
                                            maxWidth="Infinity" />

                                    </children>

                                </VBox>

                            </children>

                        </HBox>


                        <!-- ================================================= -->
                        <!-- DIVIDER -->
                        <!-- ================================================= -->

                        <Region
                            prefHeight="1.0"
                            maxHeight="1.0"
                            style="-fx-background-color: #E0E2E4;" />


                        <!-- ================================================= -->
                        <!-- BUTTONS -->
                        <!-- ================================================= -->

                        <HBox
                            alignment="CENTER_RIGHT"
                            spacing="12.0">

                            <children>

                                <Button
                                    fx:id="btnBack"
                                    mnemonicParsing="false"
                                    onAction="#handleBack"
                                    text="Back"
                                    prefHeight="45.0"
                                    prefWidth="120.0"
                                    style="-fx-background-color: white;
                                           -fx-text-fill: #555B60;
                                           -fx-font-weight: bold;
                                           -fx-border-color: #C1C5C9;
                                           -fx-border-width: 1;
                                           -fx-border-radius: 8;
                                           -fx-background-radius: 8;
                                           -fx-cursor: hand;">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Button>


                                <Button
                                    fx:id="btnSave"
                                    mnemonicParsing="false"
                                    onAction="#handleSave"
                                    text="Save Changes"
                                    prefHeight="45.0"
                                    prefWidth="150.0"
                                    style="-fx-background-color: #4F7A5A;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8;
                                           -fx-cursor: hand;
                                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 6, 0.1, 0, 2);">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Button>

                            </children>

                        </HBox>

                    </children>

                </VBox>

            </children>

        </VBox>

    </center>

</BorderPane>