<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
    minWidth="700.0"
    minHeight="550.0"
    prefWidth="1100.0"
    prefHeight="700.0"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controllers.EmployeeViewController">

    <!-- ========================================================= -->
    <!-- TOP NAVIGATION -->
    <!-- ========================================================= -->

    <top>

        <HBox
            alignment="CENTER_LEFT"
            minHeight="70.0"
            prefHeight="70.0"
            spacing="15.0"
            style="-fx-background-color: #2F3438;
                   -fx-padding: 0 25 0 25;">

            <children>

                <!-- BRAND -->

                <VBox
                    alignment="CENTER_LEFT"
                    spacing="2.0">

                    <children>

                        <Label
                            text="PDR CAR RENTAL"
                            textFill="WHITE">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="20.0" />
                            </font>

                        </Label>

                        <Label
                            text="EMPLOYEE MANAGEMENT"
                            textFill="#BFC3C7">

                            <font>
                                <Font
                                    size="10.0" />
                            </font>

                        </Label>

                    </children>

                </VBox>


                <!-- FLEXIBLE SPACE -->

                <Region
                    HBox.hgrow="ALWAYS" />


                <!-- DASHBOARD -->

                <MenuButton
                    fx:id="btnDashboard"
                    mnemonicParsing="false"
                    text="Dashboard"
                    prefHeight="42.0"
                    style="-fx-background-color: #555B60;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;
                           -fx-padding: 0 18 0 18;">

                    <font>
                        <Font
                            name="System Bold"
                            size="14.0" />
                    </font>

                    <items>

                        <MenuItem
                            text="Customers"
                            onAction="#openCustomers" />

                        <MenuItem
                            text="Payments"
                            onAction="#openPayments" />

                        <MenuItem
                            text="Cars"
                            onAction="#openCars" />

                        <MenuItem
                            text="Employees"
                            onAction="#openEmployees" />

                        <MenuItem
                            text="Rentals"
                            onAction="#openRentals" />

                    </items>

                </MenuButton>


                <!-- LOGOUT -->

                <Button
                    mnemonicParsing="false"
                    text="Logout"
                    onAction="#handleLogout"
                    prefHeight="42.0"
                    prefWidth="90.0"
                    style="-fx-background-color: #B94A48;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;">

                    <font>
                        <Font
                            name="System Bold"
                            size="13.0" />
                    </font>

                </Button>

            </children>

        </HBox>

    </top>


    <!-- ========================================================= -->
    <!-- CENTER -->
    <!-- ========================================================= -->

    <center>

        <VBox
            spacing="22.0"
            fillWidth="true"
            style="-fx-background-color: linear-gradient(to bottom right, #F5F5F5, #D9DDE1);
                   -fx-padding: 30 35 35 35;">

            <children>


                <!-- ================================================= -->
                <!-- PAGE TITLE -->
                <!-- ================================================= -->

                <VBox
                    spacing="5.0">

                    <children>

                        <Label
                            text="Employee Management"
                            textFill="#303438">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="30.0" />
                            </font>

                        </Label>

                        <Label
                            text="Add, update, search and manage employees"
                            textFill="#777D83">

                            <font>
                                <Font
                                    size="14.0" />
                            </font>

                        </Label>

                    </children>

                </VBox>


                <!-- ================================================= -->
                <!-- SEARCH + ACTION CARD -->
                <!-- ================================================= -->

                <HBox
                    alignment="CENTER_LEFT"
                    spacing="12.0"
                    fillHeight="true"
                    style="-fx-background-color: white;
                           -fx-background-radius: 14;
                           -fx-border-color: #C6C9CC;
                           -fx-border-width: 1;
                           -fx-border-radius: 14;
                           -fx-padding: 16;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0.1, 0, 3);">

                    <children>


                        <!-- SEARCH -->

                        <TextField
                            fx:id="txtSearch"
                            promptText="Search employee..."
                            prefHeight="44.0"
                            minWidth="180.0"
                            HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #F7F7F7;
                                   -fx-border-color: #C1C5C9;
                                   -fx-border-width: 1;
                                   -fx-border-radius: 9;
                                   -fx-background-radius: 9;
                                   -fx-padding: 0 15 0 15;
                                   -fx-font-size: 14px;">

                            <font>
                                <Font
                                    size="14.0" />
                            </font>

                        </TextField>


                        <!-- SEARCH -->

                        <Button
                            mnemonicParsing="false"
                            text="Search"
                            prefHeight="44.0"
                            prefWidth="105.0"
                            style="-fx-background-color: #555B60;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 9;
                                   -fx-cursor: hand;">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="13.0" />
                            </font>

                        </Button>


                        <!-- ADD -->

                        <Button
                            fx:id="btnAdd"
                            mnemonicParsing="false"
                            text="＋  Add Employee"
                            onAction="#handleAdd"
                            prefHeight="44.0"
                            prefWidth="145.0"
                            style="-fx-background-color: #4F7A5A;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 9;
                                   -fx-cursor: hand;">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="13.0" />
                            </font>

                        </Button>


                        <!-- UPDATE -->

                        <Button
                            fx:id="btnUpdate"
                            mnemonicParsing="false"
                            text="Update"
                            onAction="#handleUpdate"
                            prefHeight="44.0"
                            prefWidth="105.0"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #444A4F;
                                   -fx-font-weight: bold;
                                   -fx-border-color: #C1C5C9;
                                   -fx-border-width: 1;
                                   -fx-border-radius: 9;
                                   -fx-background-radius: 9;
                                   -fx-cursor: hand;">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="13.0" />
                            </font>

                        </Button>


                        <!-- DELETE -->

                        <Button
                            fx:id="btnDelete"
                            mnemonicParsing="false"
                            text="Delete"
                            onAction="#handleDelete"
                            prefHeight="44.0"
                            prefWidth="105.0"
                            style="-fx-background-color: #B94A48;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 9;
                                   -fx-cursor: hand;">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="13.0" />
                            </font>

                        </Button>

                    </children>

                </HBox>


                <!-- ================================================= -->
                <!-- EMPLOYEE TABLE CARD -->
                <!-- ================================================= -->

                <VBox
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color: white;
                           -fx-background-radius: 14;
                           -fx-border-color: #C6C9CC;
                           -fx-border-width: 1;
                           -fx-border-radius: 14;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0.1, 0, 4);">

                    <children>


                        <!-- TABLE HEADER -->

                        <HBox
                            alignment="CENTER_LEFT"
                            minHeight="55.0"
                            spacing="10.0"
                            style="-fx-padding: 0 18 0 18;
                                   -fx-background-color: #ECEEEF;
                                   -fx-background-radius: 14 14 0 0;">

                            <children>

                                <Label
                                    text="EMPLOYEE LIST"
                                    textFill="#444A4F">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="14.0" />
                                    </font>

                                </Label>


                                <Region
                                    HBox.hgrow="ALWAYS" />


                                <Label
                                    text="Employee Records"
                                    textFill="#858A8F">

                                    <font>
                                        <Font
                                            size="12.0" />
                                    </font>

                                </Label>

                            </children>

                        </HBox>


                        <!-- TABLE -->

                        <TableView
                            fx:id="tblEmployees"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            VBox.vgrow="ALWAYS"
                            style="-fx-background-color: white;
                                   -fx-border-color: transparent;
                                   -fx-table-cell-border-color: #E1E3E5;
                                   -fx-font-size: 13px;">

                            <columnResizePolicy>
                                <TableView
                                    fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                            </columnResizePolicy>


                            <columns>


                                <!-- ID -->

                                <TableColumn
                                    fx:id="colid"
                                    text="ID"
                                    minWidth="60.0"
                                    prefWidth="70.0" />


                                <!-- USERNAME -->

                                <TableColumn
                                    fx:id="colusename"
                                    text="USERNAME"
                                    minWidth="120.0"
                                    prefWidth="150.0" />


                                <!-- ROLE -->

                                <TableColumn
                                    fx:id="colrole"
                                    text="ROLE"
                                    minWidth="90.0"
                                    prefWidth="110.0" />


                                <!-- FIRST NAME -->

                                <TableColumn
                                    fx:id="colfirstname"
                                    text="FIRST NAME"
                                    minWidth="120.0"
                                    prefWidth="150.0" />


                                <!-- LAST NAME -->

                                <TableColumn
                                    fx:id="collastname"
                                    text="LAST NAME"
                                    minWidth="120.0"
                                    prefWidth="150.0" />


                                <!-- PHONE -->

                                <TableColumn
                                    fx:id="colphone"
                                    text="PHONE"
                                    minWidth="120.0"
                                    prefWidth="150.0" />


                                <!-- LAST LOGIN -->

                                <TableColumn
                                    fx:id="collastlogin"
                                    text="LAST LOGIN"
                                    minWidth="150.0"
                                    prefWidth="180.0" />

                            </columns>

                        </TableView>

                    </children>

                </VBox>

            </children>

        </VBox>

    </center>

</BorderPane>