<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
    minHeight="550.0"
    minWidth="700.0"
    prefHeight="700.0"
    prefWidth="1100.0"
    xmlns="http://javafx.com/javafx/26"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controllers.CustomerController">

    <!-- ================= TOP NAVIGATION ================= -->

    <top>

        <HBox
            alignment="CENTER_LEFT"
            minHeight="70.0"
            prefHeight="70.0"
            spacing="15.0"
            style="-fx-background-color: #2F3438;
                   -fx-padding: 0 25 0 25;">

            <children>

                <VBox
                    alignment="CENTER_LEFT"
                    spacing="2.0">

                    <children>

                        <Label
                            text="PDR CAR RENTAL"
                            textFill="WHITE">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="20.0" />
                            </font>

                        </Label>

                        <Label
                            text="CUSTOMER MANAGEMENT"
                            textFill="#BFC3C7">

                            <font>
                                <Font size="10.0" />
                            </font>

                        </Label>

                    </children>

                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <MenuButton
                    fx:id="btnDashboard"
                    mnemonicParsing="false"
                    prefHeight="42.0"
                    text="Dashboard"
                    style="-fx-background-color: #555B60;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;
                           -fx-padding: 0 18 0 18;">

                    <font>
                        <Font
                            name="System Bold"
                            size="14.0" />
                    </font>

                    <items>

                        <MenuItem
                            text="Customers"
                            onAction="#openCustomers" />

                        <MenuItem
                            text="Payments"
                            onAction="#openPayments" />

                        <MenuItem
                            text="Cars"
                            onAction="#openCars" />

                        <MenuItem
                            text="Employees"
                            onAction="#openEmployees" />

                        <MenuItem
                            text="Rentals"
                            onAction="#openRentals" />

                    </items>

                </MenuButton>

            </children>

        </HBox>

    </top>


    <!-- ================= CENTER ================= -->

    <center>

        <VBox
            fillWidth="true"
            spacing="22.0"
            style="-fx-background-color: linear-gradient(to bottom right, #F5F5F5, #D9DDE1);
                   -fx-padding: 30 35 35 35;">

            <children>

                <!-- ================= PAGE TITLE ================= -->

                <VBox spacing="5.0">

                    <children>

                        <Label
                            text="Customer Management"
                            textFill="#303438">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="30.0" />
                            </font>

                        </Label>

                        <Label
                            text="Add, update, search and manage customers"
                            textFill="#777D83">

                            <font>
                                <Font size="14.0" />
                            </font>

                        </Label>

                    </children>

                </VBox>


                <!-- ================= CUSTOMER FORM ================= -->

                <VBox
                    fillWidth="true"
                    spacing="15.0"
                    style="-fx-background-color: white;
                           -fx-background-radius: 14;
                           -fx-border-color: #C6C9CC;
                           -fx-border-width: 1;
                           -fx-border-radius: 14;
                           -fx-padding: 20;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0.1, 0, 3);">

                    <children>

                        <Label
                            text="Customer Information"
                            textFill="#444A4F">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="16.0" />
                            </font>

                        </Label>


                        <GridPane
                            hgap="15.0"
                            vgap="12.0"
                            maxWidth="Infinity">

                            <columnConstraints>

                                <ColumnConstraints
                                    minWidth="80.0"
                                    prefWidth="100.0"
                                    hgrow="NEVER" />

                                <ColumnConstraints
                                    minWidth="150.0"
                                    hgrow="ALWAYS" />

                                <ColumnConstraints
                                    minWidth="80.0"
                                    prefWidth="100.0"
                                    hgrow="NEVER" />

                                <ColumnConstraints
                                    minWidth="150.0"
                                    hgrow="ALWAYS" />

                            </columnConstraints>

                            <rowConstraints>

                                <RowConstraints
                                    minHeight="40.0"
                                    prefHeight="40.0" />

                                <RowConstraints
                                    minHeight="40.0"
                                    prefHeight="40.0" />

                            </rowConstraints>

                            <children>

                                <!-- FIRST NAME -->

                                <Label
                                    text="First Name"
                                    textFill="#555B60">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Label>

                                <TextField
                                    fx:id="txtfirstname"
                                    promptText="Enter first name"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    style="-fx-background-color: #F7F7F7;
                                           -fx-border-color: #C8CCD0;
                                           -fx-border-radius: 7;
                                           -fx-background-radius: 7;
                                           -fx-padding: 0 12 0 12;" />


                                <!-- LAST NAME -->

                                <Label
                                    text="Last Name"
                                    textFill="#555B60"
                                    GridPane.columnIndex="2">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Label>

                                <TextField
                                    fx:id="txtlastname"
                                    promptText="Enter last name"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="3"
                                    style="-fx-background-color: #F7F7F7;
                                           -fx-border-color: #C8CCD0;
                                           -fx-border-radius: 7;
                                           -fx-background-radius: 7;
                                           -fx-padding: 0 12 0 12;" />


                                <!-- PHONE -->

                                <Label
                                    text="Phone"
                                    textFill="#555B60"
                                    GridPane.rowIndex="1">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Label>

                                <TextField
                                    fx:id="txtphone"
                                    promptText="Enter phone number"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"
                                    style="-fx-background-color: #F7F7F7;
                                           -fx-border-color: #C8CCD0;
                                           -fx-border-radius: 7;
                                           -fx-background-radius: 7;
                                           -fx-padding: 0 12 0 12;" />


                                <!-- EMAIL -->

                                <Label
                                    text="Email"
                                    textFill="#555B60"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="1">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Label>

                                <TextField
                                    fx:id="txtemail"
                                    promptText="Enter email address"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="1"
                                    style="-fx-background-color: #F7F7F7;
                                           -fx-border-color: #C8CCD0;
                                           -fx-border-radius: 7;
                                           -fx-background-radius: 7;
                                           -fx-padding: 0 12 0 12;" />

                            </children>

                        </GridPane>

                    </children>

                </VBox>


                <!-- ================= SEARCH + BUTTONS ================= -->

                <HBox
                    alignment="CENTER_LEFT"
                    spacing="12.0">

                    <children>

                        <TextField
                            fx:id="txtSearch"
                            promptText="Search customer..."
                            prefHeight="44.0"
                            minWidth="180.0"
                            HBox.hgrow="ALWAYS"
                            style="-fx-background-color: white;
                                   -fx-border-color: #C1C5C9;
                                   -fx-border-width: 1;
                                   -fx-border-radius: 9;
                                   -fx-background-radius: 9;
                                   -fx-padding: 0 15 0 15;
                                   -fx-font-size: 14px;" />


                        <Button
                            fx:id="btnsearch"
                            text="Search"
                            onAction="#handleSearch"
                            prefHeight="44.0"
                            prefWidth="105.0"
                            style="-fx-background-color: #555B60;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 9;
                                   -fx-cursor: hand;">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="13.0" />
                            </font>

                        </Button>


                        <Button
                            fx:id="btnAdd"
                            text="＋  Add Customer"
                            onAction="#handleAdd"
                            prefHeight="44.0"
                            prefWidth="140.0"
                            style="-fx-background-color: #4F7A5A;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 9;
                                   -fx-cursor: hand;">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="13.0" />
                            </font>

                        </Button>


                        <Button
                            fx:id="btnEdit"
                            text="Update"
                            onAction="#handleEdit"
                            prefHeight="44.0"
                            prefWidth="105.0"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #444A4F;
                                   -fx-font-weight: bold;
                                   -fx-border-color: #C1C5C9;
                                   -fx-border-width: 1;
                                   -fx-border-radius: 9;
                                   -fx-background-radius: 9;
                                   -fx-cursor: hand;">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="13.0" />
                            </font>

                        </Button>


                        <Button
                            fx:id="btnDelete"
                            text="Delete"
                            onAction="#handleDelete"
                            prefHeight="44.0"
                            prefWidth="105.0"
                            style="-fx-background-color: #B94A48;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 9;
                                   -fx-cursor: hand;">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="13.0" />
                            </font>

                        </Button>

                    </children>

                </HBox>


                <!-- ================= CUSTOMER TABLE ================= -->

                <VBox
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color: white;
                           -fx-background-radius: 14;
                           -fx-border-color: #C6C9CC;
                           -fx-border-width: 1;
                           -fx-border-radius: 14;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0.1, 0, 4);">

                    <children>

                        <HBox
                            alignment="CENTER_LEFT"
                            minHeight="52.0"
                            spacing="10.0"
                            style="-fx-padding: 0 18 0 18;
                                   -fx-background-color: #ECEEEF;
                                   -fx-background-radius: 14 14 0 0;">

                            <children>

                                <Label
                                    text="CUSTOMER LIST"
                                    textFill="#444A4F">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="14.0" />
                                    </font>

                                </Label>

                                <Region HBox.hgrow="ALWAYS" />

                                <Label
                                    text="Customer Records"
                                    textFill="#858A8F">

                                    <font>
                                        <Font size="12.0" />
                                    </font>

                                </Label>

                            </children>

                        </HBox>


                        <TableView
                            fx:id="tblMovies"
                            VBox.vgrow="ALWAYS"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            style="-fx-background-color: white;
                                   -fx-border-color: transparent;
                                   -fx-table-cell-border-color: #E1E3E5;
                                   -fx-font-size: 13px;">

                            <columnResizePolicy>
                                <TableView
                                    fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                            </columnResizePolicy>

                            <columns>

                                <TableColumn
                                    fx:id="colId"
                                    text="ID"
                                    minWidth="60.0"
                                    prefWidth="70.0" />

                                <TableColumn
                                    fx:id="colTitle"
                                    text="First Name"
                                    minWidth="120.0"
                                    prefWidth="180.0" />

                                <TableColumn
                                    fx:id="colDescription"
                                    text="Last Name"
                                    minWidth="120.0"
                                    prefWidth="180.0" />

                                <TableColumn
                                    fx:id="colGenre"
                                    text="Phone"
                                    minWidth="120.0"
                                    prefWidth="170.0" />

                                <TableColumn
                                    fx:id="colLanguage"
                                    text="Email"
                                    minWidth="150.0"
                                    prefWidth="220.0" />

                            </columns>

                        </TableView>

                    </children>

                </VBox>

            </children>

        </VBox>

    </center>

</BorderPane>