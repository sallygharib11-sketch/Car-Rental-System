<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
    minWidth="650.0"
    minHeight="550.0"
    prefWidth="1000.0"
    prefHeight="700.0"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controllers.AddEmployeeController">

    <!-- ========================================================= -->
    <!-- TOP NAVIGATION -->
    <!-- ========================================================= -->

    <top>

        <HBox
            alignment="CENTER_LEFT"
            minHeight="70.0"
            prefHeight="70.0"
            spacing="15.0"
            style="-fx-background-color: #2F3438;
                   -fx-padding: 0 25 0 25;">

            <children>

                <!-- BRAND -->

                <VBox
                    alignment="CENTER_LEFT"
                    spacing="2.0">

                    <children>

                        <Label
                            text="PDR CAR RENTAL"
                            textFill="WHITE">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="20.0" />
                            </font>

                        </Label>

                        <Label
                            text="EMPLOYEE MANAGEMENT"
                            textFill="#BFC3C7">

                            <font>
                                <Font
                                    size="10.0" />
                            </font>

                        </Label>

                    </children>

                </VBox>


                <!-- FLEXIBLE SPACE -->

                <Region
                    HBox.hgrow="ALWAYS" />


                <!-- DASHBOARD -->

                <MenuButton
                    fx:id="btnDashboard"
                    mnemonicParsing="false"
                    text="Dashboard"
                    prefHeight="42.0"
                    style="-fx-background-color: #555B60;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;
                           -fx-padding: 0 18 0 18;">

                    <font>
                        <Font
                            name="System Bold"
                            size="14.0" />
                    </font>

                    <items>

                        <MenuItem
                            text="Customers"
                            onAction="#openCustomers" />

                        <MenuItem
                            text="Payments"
                            onAction="#openPayments" />

                        <MenuItem
                            text="Cars"
                            onAction="#openCars" />

                        <MenuItem
                            text="Employees"
                            onAction="#openEmployees" />

                        <MenuItem
                            text="Rentals"
                            onAction="#openRentals" />

                    </items>

                </MenuButton>


                <!-- LOGOUT -->

                <Button
                    fx:id="btnLogout"
                    mnemonicParsing="false"
                    text="Logout"
                    onAction="#handleLogout"
                    prefHeight="42.0"
                    prefWidth="90.0"
                    style="-fx-background-color: #B94A48;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;">

                    <font>
                        <Font
                            name="System Bold"
                            size="13.0" />
                    </font>

                </Button>

            </children>

        </HBox>

    </top>


    <!-- ========================================================= -->
    <!-- CENTER -->
    <!-- ========================================================= -->

    <center>

        <VBox
            alignment="TOP_CENTER"
            spacing="22.0"
            fillWidth="true"
            style="-fx-background-color: linear-gradient(to bottom right, #F5F5F5, #D9DDE1);
                   -fx-padding: 30 35 35 35;">

            <children>


                <!-- ================================================= -->
                <!-- PAGE TITLE -->
                <!-- ================================================= -->

                <VBox
                    alignment="CENTER_LEFT"
                    spacing="5.0"
                    maxWidth="900.0">

                    <children>

                        <Label
                            text="Add Employee"
                            textFill="#303438">

                            <font>
                                <Font
                                    name="System Bold"
                                    size="30.0" />
                            </font>

                        </Label>

                        <Label
                            text="Create a new employee account"
                            textFill="#777D83">

                            <font>
                                <Font
                                    size="14.0" />
                            </font>

                        </Label>

                    </children>

                </VBox>


                <!-- ================================================= -->
                <!-- FORM CARD -->
                <!-- ================================================= -->

                <VBox
                    spacing="20.0"
                    maxWidth="900.0"
                    fillWidth="true"
                    style="-fx-background-color: white;
                           -fx-background-radius: 16;
                           -fx-border-color: #C6C9CC;
                           -fx-border-width: 1;
                           -fx-border-radius: 16;
                           -fx-padding: 30;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 15, 0.1, 0, 4);">

                    <children>


                        <!-- FORM HEADER -->

                        <VBox
                            spacing="4.0">

                            <children>

                                <Label
                                    text="Employee Information"
                                    textFill="#444A4F">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="18.0" />
                                    </font>

                                </Label>

                                <Label
                                    text="Enter the employee details below"
                                    textFill="#858A8F">

                                    <font>
                                        <Font
                                            size="12.0" />
                                    </font>

                                </Label>

                            </children>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- FORM -->
                        <!-- ================================================= -->

                        <GridPane
                            hgap="18.0"
                            vgap="15.0"
                            maxWidth="Infinity">

                            <columnConstraints>

                                <ColumnConstraints
                                    minWidth="120.0"
                                    prefWidth="150.0"
                                    hgrow="NEVER" />

                                <ColumnConstraints
                                    minWidth="250.0"
                                    hgrow="ALWAYS" />

                            </columnConstraints>

                            <rowConstraints>

                                <RowConstraints
                                    minHeight="52.0"
                                    prefHeight="52.0" />

                                <RowConstraints
                                    minHeight="52.0"
                                    prefHeight="52.0" />

                                <RowConstraints
                                    minHeight="52.0"
                                    prefHeight="52.0" />

                                <RowConstraints
                                    minHeight="52.0"
                                    prefHeight="52.0" />

                                <RowConstraints
                                    minHeight="52.0"
                                    prefHeight="52.0" />

                            </rowConstraints>

                            <children>


                                <!-- FULL NAME -->

                                <Label
                                    text="Full Name"
                                    textFill="#555B60"
                                    GridPane.rowIndex="0">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Label>

                                <TextField
                                    fx:id="txtFullName"
                                    promptText="Enter full name"
                                    prefHeight="46.0"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"
                                    style="-fx-background-color: #F7F7F7;
                                           -fx-text-fill: #303438;
                                           -fx-prompt-text-fill: #9A9EA2;
                                           -fx-border-color: #C2C5C8;
                                           -fx-border-width: 1;
                                           -fx-border-radius: 9;
                                           -fx-background-radius: 9;
                                           -fx-padding: 0 14 0 14;
                                           -fx-font-size: 14px;" />


                                <!-- USERNAME -->

                                <Label
                                    text="Username"
                                    textFill="#555B60"
                                    GridPane.rowIndex="1">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Label>

                                <TextField
                                    fx:id="txtUsername"
                                    promptText="Enter username"
                                    prefHeight="46.0"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"
                                    style="-fx-background-color: #F7F7F7;
                                           -fx-text-fill: #303438;
                                           -fx-prompt-text-fill: #9A9EA2;
                                           -fx-border-color: #C2C5C8;
                                           -fx-border-width: 1;
                                           -fx-border-radius: 9;
                                           -fx-background-radius: 9;
                                           -fx-padding: 0 14 0 14;
                                           -fx-font-size: 14px;" />


                                <!-- PASSWORD -->

                                <Label
                                    text="Password"
                                    textFill="#555B60"
                                    GridPane.rowIndex="2">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Label>

                                <PasswordField
                                    fx:id="txtPassword"
                                    promptText="Enter password"
                                    prefHeight="46.0"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"
                                    style="-fx-background-color: #F7F7F7;
                                           -fx-text-fill: #303438;
                                           -fx-prompt-text-fill: #9A9EA2;
                                           -fx-border-color: #C2C5C8;
                                           -fx-border-width: 1;
                                           -fx-border-radius: 9;
                                           -fx-background-radius: 9;
                                           -fx-padding: 0 14 0 14;
                                           -fx-font-size: 14px;" />


                                <!-- ROLE -->

                                <Label
                                    text="Role"
                                    textFill="#555B60"
                                    GridPane.rowIndex="3">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Label>

                                <ComboBox
                                    fx:id="cmbRole"
                                    promptText="Select employee role"
                                    prefHeight="46.0"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3"
                                    style="-fx-background-color: #F7F7F7;
                                           -fx-border-color: #C2C5C8;
                                           -fx-border-width: 1;
                                           -fx-border-radius: 9;
                                           -fx-background-radius: 9;
                                           -fx-font-size: 14px;" />


                                <!-- CINEMA -->

                                <Label
                                    text="Cinema"
                                    textFill="#555B60"
                                    GridPane.rowIndex="4">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Label>

                                <ComboBox
                                    fx:id="cmbCinema"
                                    promptText="Select cinema"
                                    prefHeight="46.0"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="4"
                                    style="-fx-background-color: #F7F7F7;
                                           -fx-border-color: #C2C5C8;
                                           -fx-border-width: 1;
                                           -fx-border-radius: 9;
                                           -fx-background-radius: 9;
                                           -fx-font-size: 14px;" />

                            </children>

                        </GridPane>


                        <!-- ================================================= -->
                        <!-- BUTTONS -->
                        <!-- ================================================= -->

                        <HBox
                            alignment="CENTER_RIGHT"
                            spacing="12.0"
                            style="-fx-padding: 10 0 0 0;">

                            <children>


                                <!-- CANCEL -->

                                <Button
                                    fx:id="btnCancel"
                                    mnemonicParsing="false"
                                    text="Cancel"
                                    onAction="#handleCancel"
                                    prefHeight="44.0"
                                    prefWidth="120.0"
                                    style="-fx-background-color: white;
                                           -fx-text-fill: #555B60;
                                           -fx-font-weight: bold;
                                           -fx-border-color: #C1C5C9;
                                           -fx-border-width: 1;
                                           -fx-border-radius: 9;
                                           -fx-background-radius: 9;
                                           -fx-cursor: hand;">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Button>


                                <!-- SAVE -->

                                <Button
                                    fx:id="btnSave"
                                    mnemonicParsing="false"
                                    text="Save Employee"
                                    onAction="#handleSave"
                                    prefHeight="44.0"
                                    prefWidth="150.0"
                                    style="-fx-background-color: #4F7A5A;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 9;
                                           -fx-cursor: hand;">

                                    <font>
                                        <Font
                                            name="System Bold"
                                            size="13.0" />
                                    </font>

                                </Button>

                            </children>

                        </HBox>

                    </children>

                </VBox>

            </children>

        </VBox>

    </center>

</BorderPane>