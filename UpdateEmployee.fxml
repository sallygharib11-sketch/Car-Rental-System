<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="620.0"
            prefWidth="650.0"
            minHeight="500.0"
            minWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.UpdateEmployeeController">

    <!-- ========================= -->
    <!-- TOP HEADER -->
    <!-- ========================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="15.0"
              style="-fx-background-color: #111111;
                     -fx-padding: 15 30 15 30;">

            <Label text="Employees 👥"
                   textFill="SILVER"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;" />

        </HBox>

    </top>


    <!-- ========================= -->
    <!-- CENTER -->
    <!-- ========================= -->

    <center>

        <VBox alignment="CENTER"
              spacing="25.0"
              style="-fx-background-color: black;
                     -fx-padding: 35;">

            <!-- PAGE TITLE -->

            <Label text="Edit Employee"
                   textFill="SILVER"
                   style="-fx-font-size: 30px;
                          -fx-font-weight: bold;" />


            <!-- ========================= -->
            <!-- FORM -->
            <!-- ========================= -->

            <GridPane alignment="CENTER"
                      hgap="18.0"
                      vgap="18.0"
                      maxWidth="550.0">

                <columnConstraints>

                    <ColumnConstraints minWidth="120.0"
                                       prefWidth="150.0" />

                    <ColumnConstraints minWidth="250.0"
                                       prefWidth="350.0"
                                       hgrow="ALWAYS" />

                </columnConstraints>


                <rowConstraints>

                    <RowConstraints minHeight="45.0" />
                    <RowConstraints minHeight="45.0" />
                    <RowConstraints minHeight="45.0" />
                    <RowConstraints minHeight="45.0" />

                </rowConstraints>


                <!-- FULL NAME -->

                <Label text="Full Name:"
                       textFill="SILVER"
                       style="-fx-font-size: 16px;"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0" />

                <TextField fx:id="txtFullName"
                           prefHeight="42.0"
                           promptText="Enter full name"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0" />


                <!-- USERNAME -->

                <Label text="Username:"
                       textFill="SILVER"
                       style="-fx-font-size: 16px;"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1" />

                <TextField fx:id="txtUsername"
                           prefHeight="42.0"
                           promptText="Enter username"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1" />


                <!-- PASSWORD -->

                <Label text="New Password:"
                       textFill="SILVER"
                       style="-fx-font-size: 16px;"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2" />

                <PasswordField fx:id="txtPassword"
                               prefHeight="42.0"
                               promptText="Leave empty to keep current password"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="2" />


                <!-- ROLE -->

                <Label text="Role:"
                       textFill="SILVER"
                       style="-fx-font-size: 16px;"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3" />

                <ComboBox fx:id="cmbRole"
                          prefHeight="42.0"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3" />

            </GridPane>


            <!-- ========================= -->
            <!-- BUTTONS -->
            <!-- ========================= -->

            <HBox alignment="CENTER"
                  spacing="20.0">

                <Button text="Update"
                        onAction="#handleUpdate"
                        prefHeight="45.0"
                        prefWidth="150.0"
                        style="-fx-background-color: #2E7D32;
                               -fx-text-fill: white;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;" />

                <Button text="Cancel"
                        onAction="#handleCancel"
                        prefHeight="45.0"
                        prefWidth="150.0"
                        style="-fx-background-color: #555555;
                               -fx-text-fill: white;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;" />

            </HBox>

        </VBox>

    </center>

</BorderPane>